# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/custom_resume_dev

# AI — Gemini (required for ADK chat; also used by LiteLLM gemini/* models)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# AI — multi-provider generation via LiteLLM (profile / OCR / roast / job)
# Examples: gemini/gemini-3-flash-preview | openai/gpt-4o-mini | anthropic/claude-sonnet-4-5
LLM_FLASH_MODEL=gemini/gemini-3-flash-preview
LLM_PRO_MODEL=gemini/gemini-3.1-pro-preview
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Auth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=your-jwt-secret-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Frontend (public key only — never put KEY_SECRET here)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# Credits
RESUME_GENERATION_CREDIT_COST=10
DAILY_FREE_CREDITS=20
SIGNUP_BONUS_CREDITS=100
REFERRAL_BONUS_CREDITS=20

# Storage — backend: local | gcs | oci
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/storage
GCS_BUCKET=your-gcs-bucket-name
GCS_CREDENTIALS_PATH=credentials/gcs-service-account.json
OCI_NAMESPACE=
OCI_BUCKET=
OCI_REGION=
OCI_CONFIG_PATH=

# LaTeX
LATEX_BIN_PATH=/Library/TeX/texbin

# App — FRONTEND_URL must match your Next.js origin; OAuth callback is {FRONTEND_URL}/auth/google/callback
ENVIRONMENT=DEV
FRONTEND_URL=http://localhost:3000
API_BASE_URL=
TRUST_PROXY_HEADERS=false
DEV_AUTH_BYPASS=false

# Reliability & Observability (Phase 7)
SENTRY_DSN=
ALERT_WEBHOOK_URL=
REDIS_URL=
RATE_LIMIT_PUBLIC_RPM=30
PUBLIC_UPLOAD_MAX_BYTES=5000000
LINKEDIN_OPTIMIZE_DAILY_LIMIT=5
OUTREACH_DAILY_LIMIT=10

# Tailor pipeline tuning (v1 deploy defaults)
MAX_RECRUITER_PASSES=1
MAX_REFINE_PASSES=2
ANALYZE_FIT_LLM_TIMEOUT=30
REFERRAL_BONUS_CREDITS=2
CALIBRATION_MIN_SAMPLE=10
REFERRAL_VELOCITY_MAX=5
REFERRAL_VELOCITY_WINDOW_HOURS=1
ALERT_ERROR_RATE_THRESHOLD_PCT=25
ALERT_ERROR_RATE_MIN_JOBS_1H=5
ALERT_ERROR_RATE_COOLDOWN_MINUTES=60
