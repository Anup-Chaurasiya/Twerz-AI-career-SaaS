# ── Tailor pipeline tuning (deploy plan Phase 2B) ────────────────────────────
MAX_RECRUITER_PASSES=1
MAX_REFINE_PASSES=2
ANALYZE_FIT_LLM_TIMEOUT=30

# ── Reliability defaults ─────────────────────────────────────────────────────
RATE_LIMIT_PUBLIC_RPM=30
PUBLIC_UPLOAD_MAX_BYTES=5000000
LINKEDIN_OPTIMIZE_DAILY_LIMIT=5
OUTREACH_DAILY_LIMIT=10

# ── Local storage fallback (temp files inside container) ─────────────────────
LOCAL_STORAGE_PATH=data/storage
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# ── LaTeX (overridden to /usr/bin inside Docker container) ───────────────────
LATEX_BIN_PATH=/usr/bin

