{
  "name": "Twerz Apply Assist",
  "description": "Capture job descriptions and apply with fit-scored tailored resumes on employer forms.",
  "version": "0.5.0",
  "manifest_version": 3,
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["http://localhost:3000/*", "http://localhost:8000/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://*/*", "http://localhost:*/*"]
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "https://*/*"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Twerz Apply Assist",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.naukri.com/*",
        "https://*.indeed.com/*",
        "https://wellfound.com/*",
        "https://www.wellfound.com/*",
        "https://*.wellfound.com/*",
        "https://angel.co/*",
        "https://boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["jd-extract.js", "form-utils.js", "content.js"],
      "css": ["apply-assist.css"]
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["form-utils.js", "apply-assist.js"],
      "css": ["apply-assist.css"]
    }
  ]
}
