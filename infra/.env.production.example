# Copy to repo root as .env on the Oracle VM (never commit .env).
# cp infra/.env.production.example .env

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
TRUST_PROXY_HEADERS=true
FRONTEND_URL=https://www.twerz.com
API_BASE_URL=https://api.twerz.com
DEV_AUTH_BYPASS=false

# ── Database (Supabase — no Postgres container on VM) ───────────────────────
# Supabase → Project Settings → Database → Connection string (URI, direct, port 5432)
#
# Supabase gives:
#   postgresql://postgres:[YOUR-PASSWORD]@db.krqemahdmwcvfvthceqb.supabase.co:5432/postgres
#
# For this app, convert to:
#   1. postgresql://  →  postgresql+asyncpg://
#   2. Append         ?ssl=require
#   3. If password has special chars (@, #, %, etc.) → percent-encode in the URL
#
# Example (project krqemahdmwcvfvthceqb):
DATABASE_URL=postgresql+asyncpg://postgres:YOUR-PASSWORD@db.krqemahdmwcvfvthceqb.supabase.co:5432/postgres?ssl=require
RUN_MIGRATIONS=true

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-python3-c-import-secrets-print-secrets-token-urlsafe-48
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── AI ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
LLM_FLASH_MODEL=gemini/gemini-3-flash-preview
LLM_PRO_MODEL=gemini/gemini-3.1-pro-preview
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Oracle Object Storage ────────────────────────────────────────────────────
STORAGE_BACKEND=oci
OCI_NAMESPACE=your-oci-namespace
OCI_BUCKET=twerz-pdfs
OCI_REGION=ap-mumbai-1
# Inside container (mounted from ~/.oci) — do not change unless mount path changes
OCI_CONFIG_PATH=/root/.oci/config
# Host path to OCI config (for docker compose volume mount)
OCI_CONFIG_DIR=${HOME}/.oci

# ── Payments ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_DEBUG=false
ALERT_WEBHOOK_URL=
REDIS_URL=

# ── LaTeX (set automatically in container) ─────────────────────────────────
LATEX_BIN_PATH=/usr/bin
