# Copy to repo root as .env on the Oracle VM (never commit .env).
# cp infra/.env.production.example .env

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
TRUST_PROXY_HEADERS=true
FRONTEND_URL=https://www.twerz.com
API_BASE_URL=https://api.twerz.com
COOKIE_DOMAIN=.twerz.com
DEV_AUTH_BYPASS=false

# ── Database (Supabase — no Postgres container on VM) ───────────────────────
# Supabase → Project Settings → Database → Connection string (URI, direct, port 5432)
#
# Supabase gives:
#   postgresql://postgres:[YOUR-PASSWORD]@db.krqemahdmwcvfvthceqb.supabase.co:5432/postgres
#
# For this app, convert to:
#   1. postgresql://  →  postgresql+asyncpg://
#   2. Append         ?ssl=require
#   3. If password has special chars (@, #, %, etc.) → percent-encode in the URL
#
# Example (project krqemahdmwcvfvthceqb):
DATABASE_URL=postgresql+asyncpg://postgres:YOUR-PASSWORD@db.krqemahdmwcvfvthceqb.supabase.co:5432/postgres?ssl=require
# Set true only for first deploy or schema changes; use ./infra/deploy-oracle.sh --migrate
RUN_MIGRATIONS=false

# Connection pool tuning (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-python3-c-import-secrets-print-secrets-token-urlsafe-48
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── AI ─────────────────────────────────────────────────────────────────────
# Generation (LiteLLM): OpenAI recommended in production (Gemini free tier quota limits)
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
LLM_FLASH_MODEL=openai/gpt-4o-mini
LLM_PRO_MODEL=openai/gpt-4o
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=

# ── Oracle Object Storage ────────────────────────────────────────────────────
STORAGE_BACKEND=oci
OCI_NAMESPACE=your-oci-namespace
OCI_BUCKET=twerz-pdfs
OCI_REGION=ap-mumbai-1
# Inside container (mounted from ~/.oci) — do not change unless mount path changes
OCI_CONFIG_PATH=/root/.oci/config
# Host path to OCI config (for docker compose volume mount)
OCI_CONFIG_DIR=${HOME}/.oci
# On VM host, ensure ~/.oci/config uses absolute key_file:
#   key_file=/root/.oci/oci_api_key.pem

# ── Payments ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_DEBUG=false
ALERT_WEBHOOK_URL=

# ── Redis (optional — enable for multi-instance rate limiting) ───────────────
# Start with: docker compose -f infra/docker-compose.prod.yml --profile redis up -d
REDIS_URL=

# ── LaTeX (set automatically in container) ─────────────────────────────────
LATEX_BIN_PATH=/usr/bin
