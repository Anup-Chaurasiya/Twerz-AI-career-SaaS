# Copy to repo root as .env on the Oracle VM (never commit .env).
# cp infra/.env.production.example .env

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
TRUST_PROXY_HEADERS=true
FRONTEND_URL=https://resume.twerz
API_BASE_URL=https://api.twerz
DEV_AUTH_BYPASS=false

# ── Database (Docker Compose service name: db) ─────────────────────────────
POSTGRES_PASSWORD=change-me-strong-random-password
# Host preflight only — container overrides via docker-compose.prod.yml
DATABASE_URL=postgresql+asyncpg://twerz:change-me-strong-random-password@localhost:5432/twerz_prod
RUN_MIGRATIONS=true

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-python3-c-import-secrets-print-secrets-token-urlsafe-48
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── AI ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
LLM_FLASH_MODEL=gemini/gemini-3-flash-preview
LLM_PRO_MODEL=gemini/gemini-3.1-pro-preview
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Tailor pipeline tuning (v1 deploy — Phase 2B) ───────────────────────────
# Tighter loops for ~90–120s generate target; golden matrix validated at these defaults
MAX_RECRUITER_PASSES=1
MAX_REFINE_PASSES=2
ANALYZE_FIT_LLM_TIMEOUT=30

# ── Credits ─────────────────────────────────────────────────────────────────
RESUME_GENERATION_CREDIT_COST=10
DAILY_FREE_CREDITS=20
SIGNUP_BONUS_CREDITS=100
REFERRAL_BONUS_CREDITS=20
REFERRAL_VELOCITY_MAX=5
REFERRAL_VELOCITY_WINDOW_HOURS=1

# ── Oracle Object Storage ────────────────────────────────────────────────────
STORAGE_BACKEND=oci
OCI_NAMESPACE=your-oci-namespace
OCI_BUCKET=twerz-pdfs
OCI_REGION=ap-mumbai-1
# Inside container (mounted from ~/.oci) — do not change unless mount path changes
OCI_CONFIG_PATH=/root/.oci/config
# Host path to OCI config (for docker compose volume mount)
OCI_CONFIG_DIR=${HOME}/.oci

# ── Payments ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Reliability & Observability ──────────────────────────────────────────────
SENTRY_DSN=
ALERT_WEBHOOK_URL=
REDIS_URL=
RATE_LIMIT_PUBLIC_RPM=30
PUBLIC_UPLOAD_MAX_BYTES=5000000
LINKEDIN_OPTIMIZE_DAILY_LIMIT=5
OUTREACH_DAILY_LIMIT=10
CALIBRATION_MIN_SAMPLE=10
ALERT_ERROR_RATE_THRESHOLD_PCT=25
ALERT_ERROR_RATE_MIN_JOBS_1H=5
ALERT_ERROR_RATE_COOLDOWN_MINUTES=60

# ── LaTeX (set automatically in container) ─────────────────────────────────
LATEX_BIN_PATH=/usr/bin
