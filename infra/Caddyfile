# Automatic HTTPS via Let's Encrypt (Caddy).
# Preferred on Oracle Linux when certbot/snapd are unavailable.
#
# One-command setup (stops Nginx, installs Caddy, obtains cert):
#   sudo ./infra/setup-caddy-ssl.sh api.twerz.com support@twerz.com
#
# Manual:
#   sudo cp infra/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

{
    email support@twerz.com
}

api.twerz.com {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy 127.0.0.1:8080 {
        flush_interval -1
    }
    request_body {
        max_size 10MB
    }
}
